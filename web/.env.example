# Supabase → Project Settings → API
# ใช้ anon key เท่านั้น — service_role ข้าม RLS ทั้งหมด ห้ามโผล่ใน frontend เด็ดขาด
# (anon key ถูกฝังใน bundle เสมอ ตัวกันคนอื่นคือ Cloudflare Zero Trust Access ที่ครอบเว็บ)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Edge Function ของ TikTok — เว้นว่างได้ถ้ายังไม่ทำส่วนอัปคลิป
# ตัวอย่าง: https://xxxxx.supabase.co/functions/v1/tiktok
VITE_TIKTOK_FN_URL=

# ต้องตรงกับ APP_TOKEN ที่ตั้งใน secret ของ Edge Function
# ⚠️ ค่านี้ถูกฝังใน bundle จึงเป็นความลับระดับเดียวกับ anon key
#    ใช้กันคนสุ่มเจอ URL เท่านั้น ตัวกันจริงคือ Cloudflare Access
VITE_APP_TOKEN=
